<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose drives all UI; the Activity only needs a no-action-bar theme.
         Uses a framework Material theme so no AppCompat/Material XML dep is
         required. The green status bar matches the app's branding. -->
    <style name="Theme.NPK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#059669</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
