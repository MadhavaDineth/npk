# Copy this file to `.env` (which is gitignored) and fill in real values.
# The Django settings read these from the environment; sensible dev fallbacks
# are used when they are unset.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# Admin / model-training API (sent as the X-Admin-Password header)
NPK_ADMIN_PASSWORD=change-me

# Database (WAMP MariaDB defaults shown; note port 3307 on this setup)
NPK_DB_NAME=npk
NPK_DB_USER=root
NPK_DB_PASSWORD=
NPK_DB_HOST=127.0.0.1
NPK_DB_PORT=3307
